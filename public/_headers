# Read by Cloudflare Pages (and Netlify). Other hosts ignore this file.

/*
  # browsers remember to use https only (one year; no includeSubDomains so other subdomains stay your call)
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # Everything the site loads comes from its own address. The two cloudflareinsights.com entries are
  # for the optional Cloudflare Web Analytics beacon; the inline style is the small stylesheet put
  # into index.html at build time and the style attributes React sets.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Everything in /assets has a hash in its file name, so a changed file always gets a new name and
# the old one can be kept for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself must always be re-checked, otherwise a new deploy would not show up
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Files that keep the same name when they change
/Vidura-Gam-Hewage-CV.pdf
  Cache-Control: public, max-age=3600
/og.jpg
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400

# Keep the free *.pages.dev addresses out of search results so only viduvish.dev gets indexed
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
